# Copy to .env and fill in.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/my_assist
DATABASE_URL_TEST=postgres://postgres:postgres@127.0.0.1:5433/my_assist_test

# Provider API keys — set the ones you use; the UI can also store them per provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Default model for new agents.
MY_ASSIST_MODEL=claude-sonnet-5
# Set to "fake" to run without any API key (scripted provider; used by e2e tests).
MY_ASSIST_PROVIDER=anthropic
# Per-run spend ceiling in USD; runs stop between iterations when exceeded.
MY_ASSIST_RUN_COST_LIMIT_USD=1.0

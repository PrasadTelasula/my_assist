# Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-...
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/my_assist
MY_ASSIST_MODEL=claude-sonnet-5
# Set to "fake" to run without an API key (scripted provider, used by e2e tests).
MY_ASSIST_PROVIDER=anthropic
# Per-run spend ceiling in USD; runs abort between iterations when exceeded.
MY_ASSIST_RUN_COST_LIMIT_USD=1.0
NEXT_PUBLIC_API_BASE=
